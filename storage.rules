rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // VisionStudio — Kullanıcı dosyaları
    match /visionStudio/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Genel kimlik doğrulamış kullanıcı erişimi
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
